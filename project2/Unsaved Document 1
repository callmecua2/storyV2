            if idx > 0:
                assert n["size"] == 0.95
    elif preset == "isometric-blocks":
        blocks = v["data"]["blocks"]
        assert 2 <= len(blocks) <= 4
        for b in blocks:
            assert len(b["label"]) <= 48
            assert b["value"] >= 0
            assert len(b["displayValue"]) <= 36
            assert isinstance(b["highlight"], bool)

