hex_re = re.compile(r"^#[0-9A-Fa-f]{6}$")

for i, s in enumerate(scenes):
    assert s["id"] == i + 1, f"ID mismatch at {i}"
    if i > 0:
        assert s["start"] == scenes[i-1]["end"], f"Continuity gap at scene {s['id']}"
    assert round(s["end"] - s["start"], 3) == s["duration"], f"Duration mismatch at scene {s['id']}"
    if s["on_screen_text"] is not None:
        words = s["on_screen_text"].split()
        assert len(words) <= 4, f"Too many words in on_screen_text at scene {s['id']}: {s['on_screen_text']}"
    v = s["visual"]
    colors = v["colors"]
    for ck, cv in colors.items():
        assert hex_re.match(cv), f"Invalid hex color {ck}={cv} at scene {s['id']}"
    cam = v["camera"]
    assert cam["fov"] == 40
    assert cam["lookAt"] == [0, 0.1, 0]
    speed = v["data"]["autoRotateSpeed"]
    assert -0.03 <= speed <= 0.03 and speed != 0
    preset = v["preset"]
    if preset in ("floating-cards", "paper-flip-stage"):
        cards = v["data"]["cards"]
        assert 1 <= len(cards) <= 3
        for c in cards:
            assert len(c["label"]) <= 48
            assert len(c["title"]) <= 100
            assert len(c["value"]) <= 64
            assert len(c["subtitle"]) <= 140
            assert isinstance(c["highlight"], bool)
    elif preset == "network-nodes":
        nodes = v["data"]["nodes"]
        assert 3 <= len(nodes) <= 6
        assert nodes[0]["size"] == 1.25 and nodes[0]["highlight"] is True
        for idx, n in enumerate(nodes):
